				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "21ec4d16-3c7c-4e41-b1ba-1a96f91d121d")
	)
	(text_box "DESIGN NOTE:\nUsed pull up resistor per data sheet: \n	\"Connect a pull-up resistor to the input.\"\n\n100k is a common value but we can use the equation:\n	Rmin > Vpullup/1mA = 5k\n1mA is generally low enough to maintain LOW"
		(exclude_from_sim no)
		(at 146.05 44.45 0)
