		(uuid "11d05840-f080-4878-a99a-dca3b8eee82e")
	)
	(text_box "DESIGN NOTE:\nUsed 22p cap per data sheet: \n	\"In some applications, adding a 22pF ceramic\n	cap in parallel with R1 may further speed up the load\n	transient responses and is thus recommended for\n	applications with large load transient step requirements.\"\n"
		(exclude_from_sim no)
		(at 146.05 73.66 0)
		(size 28.194 25.4)
		(margins 1.3525 1.3525 1.3525 1.3525)
