	)
	(text_box "DESIGN NOTE:\nResistor calculations:\nPer the datasheet, we use the following equations to verify phils lab values:\n	Vout = 0.6(1 + R1/R2)\n		AND\n	R2 = (0.6V * R1)/(Vout - 0.6V)\nFor 1V output:\n	Vout = 0.6(1 + 68k/100k) = 1.008 V\nFor 1.8V output:\n	Vout = 0.6(1 + 200k/100k) = 1.8V\nFor 3V output: \n	Vout = 0.6(1 + 453k/100k) = 3.32V"
		(exclude_from_sim no)
		(at 194.31 40.64 0)
		(size 35.56 31.75)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 3 9 250 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "10b6d0cb-8fe8-4e76-a51d-b898c9fbfa51")
	)
	(text_box "[${#}] ${TITLE}"
		(exclude_from_sim no)
